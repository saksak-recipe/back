# Add these keys to the project root `.env` (already gitignored).
# Used by docker-compose.monitoring.yml via env_file: ./.env
# Postgres exporter reuses existing DB_USER / DB_PASSWORD / DB_NAME (config.py) — no DATA_SOURCE_NAME needed.

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-strong-password

# Same Discord webhook as Jenkins is fine
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE/ME
